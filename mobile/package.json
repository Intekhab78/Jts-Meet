{
  "name": "jts-meet-mobile",
  "version": "1.0.0",
  "description": "JTS Meet Mobile App (Android / iOS)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "run:android": "npx cap run android",
    "apk": "npm run build:apk",
    "build:apk": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "build:release": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.2"
  }
}
