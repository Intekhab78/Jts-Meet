# ==========================================
# JTS Meet - Backend Environment Configuration
# ==========================================

# Server Core
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/jts_meet
REDIS_URL=redis://localhost:6379

# Authentication & Security
# WARNING: In production, generate a secure random 64-char string (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN=365d
ADMIN_EMAIL=admin@jtsmeet.com

# Origins & URLs
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:4000
# Comma-separated list of additional allowed origins for CORS (e.g. https://customdomain.com)
ALLOWED_ORIGINS=

# LiveKit Selective Forwarding Unit (SFU) Media Server
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (Azure AD) Credentials
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common

# Google Gemini AI Intelligence API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Email Service (Nodemailer SMTP)
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="JTS-Meet" <noreply@jtsmeet.com>

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jtsmeet.com

# Cloudinary Storage (Optional: local disk storage used if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateways (Stripe / Razorpay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
